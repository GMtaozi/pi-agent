# Server Configuration
NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# Database
# DB_DRIVER: 'sqlite' (default) or 'postgres'
DB_DRIVER=sqlite
DATABASE_PATH=./data/workforge.db
# PostgreSQL settings (used when DB_DRIVER=postgres)
DATABASE_URL=postgresql://workforge:workforge123@localhost:5432/workforge
POSTGRES_DB=workforge
POSTGRES_USER=workforge
POSTGRES_PASSWORD=workforge123

# Redis
REDIS_URL=redis://:redis123@localhost:6379
REDIS_PASSWORD=redis123

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=workforge
MINIO_SECRET_KEY=workforge123
MINIO_BUCKET=workforge
MINIO_ROOT_USER=workforge
MINIO_ROOT_PASSWORD=workforge123

# Qdrant (vector database - alternative to pgvector)
QDRANT_URL=http://localhost:6333

# Logging
# (logger level is configured in code; no env override currently)

# Security
# - CORS_ORIGIN: comma-separated allowlist of CORS origins (no spaces).
#   Requests from any other origin are rejected.
#   Example: http://localhost:5173,https://app.acme.com
CORS_ORIGIN=http://localhost:5173

# Session/API authentication. CHANGE THESE in production.
# - SESSION_SECRET: signs session Bearer tokens.
# - ADMIN_PASSWORD: password accepted by POST /api/auth/login. When unset,
#   login is open (development only).
# - DB_ENCRYPTION_KEY: key used to encrypt custom model API keys at rest.
# - CONFIG_MASTER_SECRET: additional secret mixed into the settings file KDF.
SESSION_SECRET=change-me
ADMIN_PASSWORD=change-me
DB_ENCRYPTION_KEY=change-me
CONFIG_MASTER_SECRET=change-me

# External APIs (optional)
# DEEPSEEK_API_KEY=your-key-here
# OPENAI_API_KEY=your-key-here
# ANTHROPIC_API_KEY=your-key-here

# Runtime behaviour (all optional)
# - PICKER_ALLOWED_ROOTS: comma-separated roots the directory-picker may browse.
#   Defaults to the user home directory when unset.
#   Example: D:\work,D:\projects
PICKER_ALLOWED_ROOTS=
# - DISABLE_FETCH_KEEPALIVE=true disables HTTP keep-alive for upstream fetches.
DISABLE_FETCH_KEEPALIVE=false
# - VERIFICATION_MODE=true puts provider-runtime in mock/verification fallback.
VERIFICATION_MODE=false
# - API_BASE_URL: base URL the agent-engine advertises to skills (default http://localhost:${PORT}).
API_BASE_URL=http://localhost:3001
# - AUTO_APPROVE_BASH=true auto-approves bash tool calls (development only).
AUTO_APPROVE_BASH=false
